<% content_for :title, "挂牌预览" %>

<div class="flex min-h-screen flex-col">
  <header class="flex items-center justify-between border-b border-stone-200 bg-white px-6 py-3">
    <div class="flex items-baseline gap-3">
      <h1 class="text-sm font-medium text-stone-700">挂牌预览</h1>
      <% if @card.used_ocr? %>
        <span class="rounded bg-amber-50 px-1.5 py-0.5 text-xs text-amber-700">OCR 识别，建议核对</span>
      <% end %>
    </div>
    <div class="flex items-center gap-4">
      <%= link_to "历史记录", cards_path, class: "text-sm text-stone-400 transition hover:text-stone-600" %>
      <%= link_to "再来一张", root_path, class: "text-sm text-stone-500 transition hover:text-stone-800" %>
    </div>
  </header>

  <% if @card.errors.any? %>
    <div class="border-b border-red-200 bg-red-50 px-6 py-2 text-sm text-red-700">
      <%= @card.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <%# 挂牌居中显示在窗口中间 %>
  <main class="flex flex-1 items-center justify-center px-6 py-12">
    <%= render "cards/badge", card: @card %>
  </main>

  <div class="border-t border-stone-200 bg-white px-6 py-4">
    <%= render "cards/size_controls", card: @card %>
  </div>

  <footer class="border-t border-stone-200 bg-white px-6 py-3 text-center text-xs text-stone-400">
    <% if @card.source_name.present? %>
      来自 <%= @card.source_name %>
    <% else %>
      来自手动输入
    <% end %>
    · 识别出 <%= @card.filled_count %>/<%= Card::FIELDS.size %> 个字段
    · <%= @card.width %> × <%= @card.height %>mm<%= "（默认）" if @card.default_size? %>
  </footer>
</div>
