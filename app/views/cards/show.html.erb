<% data = @card.normalized_data %>
<% has_portrait = @card.portrait.attached? %>

<div class="badge"
     style="--badge-scale: <%= @card.default_size? ? 2 : 1.5 %>;
            --badge-width: <%= @card.width %>mm;
            --badge-height: <%= @card.height %>mm;">
  <div class="badge__punch"></div>

  <div class="badge__header">
    <p class="badge__host-org"><%= data["host_organization"] %></p>
    <p class="badge__host-dept"><%= data["host_department"] %></p>
    <p class="badge__topic"><%= data["event_topic"] %></p>
  </div>

  <% if has_portrait %>
    <%= image_tag @card.portrait, class: "badge__photo", alt: "证件照" %>
  <% else %>
    <div class="badge__photo badge__photo--empty">无照片</div>
  <% end %>

  <p class="badge__name<%= " badge__placeholder" if data["name"].blank? %>">
    <%= data["name"].presence || "未识别姓名" %>
  </p>

  <div class="badge__rule"></div>

  <p class="badge__org<%= " badge__placeholder" if data["organization"].blank? %>">
    <%= data["organization"].presence || "未识别单位" %>
  </p>
</div>
