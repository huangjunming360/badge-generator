<% content_for :title, "输入个人资料" %>

<div class="mx-auto max-w-2xl px-6 py-16">
  <header class="mb-8">
    <h1 class="text-xl font-medium text-stone-800">名片资料标准化</h1>
    <p class="mt-2 text-sm text-stone-500">
      粘贴文字，或上传简历、员工信息表，AI 会自动整理成结构化数据。
    </p>
  </header>

  <%= form_with model: @card, class: "space-y-5" do |f| %>
    <% if @card.errors.any? %>
      <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
        <% @card.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <div data-controller="upload">
      <%= f.text_area :raw_input,
            rows: 9,
            data: { upload_target: "textarea" },
            placeholder: "例如：我叫林小明，在某某科技有限公司用户增长部担任高级产品经理，手机 13800138000，邮箱 lin@example.com。",
            class: "w-full resize-y rounded-xl border border-stone-200 bg-white px-4 py-3 text-sm leading-relaxed text-stone-800 placeholder-stone-400 outline-none transition focus:border-stone-400" %>

      <div class="mt-3 flex items-center gap-3">
        <label class="cursor-pointer rounded-lg border border-stone-200 bg-white px-3 py-2 text-sm text-stone-600 transition hover:bg-stone-50">
          选择文件
          <%= f.file_field :document,
                accept: DocumentTextExtractor::ACCEPT_ATTRIBUTE,
                class: "hidden",
                data: { upload_target: "input", action: "change->upload#show" } %>
        </label>
        <span data-upload-target="filename" class="truncate text-sm text-stone-400">
          支持 docx、pdf、xlsx、csv、txt 和图片（扫描件走 OCR），上传后将忽略上方文字
        </span>
      </div>
    </div>

    <div data-controller="portrait" style="border-top:1px solid #e7e5e4;padding-top:20px;margin-top:20px">
      <h2 style="font-size:14px;margin:0 0 4px 0;color:#44403c">证件照（可选）</h2>
      <p style="font-size:12px;margin:0 0 12px 0;color:#a8a29e">用于后续生成名片，本阶段仅保存。PNG 或 JPG，5MB 以内。</p>

      <div style="display:flex;align-items:center;gap:16px">
        <div data-portrait-target="frame"
             style="display:flex;width:72px;height:96px;flex-shrink:0;align-items:center;justify-content:center;overflow:hidden;border:1px dashed #d6d3d1;border-radius:8px;background:#fafaf9">
          <span data-portrait-target="placeholder" style="font-size:12px;color:#a8a29e">无照片</span>
          <img data-portrait-target="image" style="display:none;width:100%;height:100%;object-fit:cover" alt="证件照预览">
        </div>

        <div>
          <label style="display:inline-block;cursor:pointer;padding:8px 12px;font-size:14px;color:#78716c;background:#fff;border:1px solid #e7e5e4;border-radius:8px">
            选择照片
            <%= f.file_field :portrait,
                  accept: "image/png,image/jpeg",
                  style: "display:none",
                  data: { portrait_target: "input", action: "change->portrait#preview" } %>
          </label>
          <p data-portrait-target="filename" style="margin-top:8px;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px;color:#a8a29e"></p>
        </div>
      </div>
    </div>

    <div class="flex items-center gap-4">
      <%= f.submit "AI 识别",
            data: { turbo_submits_with: "识别中…" },
            class: "cursor-pointer rounded-xl bg-stone-800 px-5 py-2.5 text-sm text-white transition hover:bg-stone-700" %>
      <%= link_to "历史记录", cards_path, class: "text-sm text-stone-400 transition hover:text-stone-600" %>
    </div>
  <% end %>
</div>
