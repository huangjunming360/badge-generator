<%# 尺寸调节。输入即实时改变预览，提交才存库。 %>
<%= form_with model: card, method: :patch,
      data: {
        controller: "badge-size",
        badge_size_min_value: Card::MIN_SIZE_MM,
        badge_size_max_value: Card::MAX_SIZE_MM,
        badge_size_default_width_value: Card::DEFAULT_WIDTH_MM,
        badge_size_default_height_value: Card::DEFAULT_HEIGHT_MM,
        badge_size_default_scale_value: Card::DEFAULT_PREVIEW_SCALE
      },
      class: "flex flex-wrap items-end gap-4" do |f| %>

  <div>
    <%= f.label :width_mm, "宽 (mm)", class: "mb-1 block text-xs text-stone-500" %>
    <%= f.number_field :width_mm, value: card.width,
          min: Card::MIN_SIZE_MM, max: Card::MAX_SIZE_MM, step: 1,
          data: { badge_size_target: "width", action: "input->badge-size#apply" },
          class: "w-24 rounded-lg border border-stone-200 bg-white px-3 py-1.5 text-sm text-stone-800 outline-none transition focus:border-stone-400" %>
  </div>

  <div>
    <%= f.label :height_mm, "高 (mm)", class: "mb-1 block text-xs text-stone-500" %>
    <%= f.number_field :height_mm, value: card.height,
          min: Card::MIN_SIZE_MM, max: Card::MAX_SIZE_MM, step: 1,
          data: { badge_size_target: "height", action: "input->badge-size#apply" },
          class: "w-24 rounded-lg border border-stone-200 bg-white px-3 py-1.5 text-sm text-stone-800 outline-none transition focus:border-stone-400" %>
  </div>

  <div>
    <%# 预览缩放只改屏幕显示大小，不入库，所以用普通 select 而非 f.select。 %>
    <label for="preview_scale" class="mb-1 block text-xs text-stone-500">预览缩放</label>
    <select id="preview_scale" name="preview_scale"
            data-badge-size-target="scale" data-action="change->badge-size#apply"
            class="w-24 rounded-lg border border-stone-200 bg-white px-3 py-1.5 text-sm text-stone-800 outline-none transition focus:border-stone-400">
      <% Card::PREVIEW_SCALES.each do |scale| %>
        <option value="<%= scale %>" <%= "selected" if scale == Card::DEFAULT_PREVIEW_SCALE %>>
          <%= "#{scale.to_s.sub(/\.0\z/, '')}×" %>
        </option>
      <% end %>
    </select>
  </div>

  <div class="flex items-center gap-2">
    <%= f.submit "保存尺寸",
          class: "cursor-pointer rounded-lg bg-stone-800 px-4 py-1.5 text-sm text-white transition hover:bg-stone-700" %>
    <button type="button" data-action="badge-size#reset"
            class="cursor-pointer rounded-lg border border-stone-200 bg-white px-3 py-1.5 text-sm text-stone-500 transition hover:bg-stone-50">
      恢复默认
    </button>
  </div>

  <p data-badge-size-target="hint" class="text-xs text-stone-400">
    默认 <%= Card::DEFAULT_WIDTH_MM %> × <%= Card::DEFAULT_HEIGHT_MM %>mm，可输入 <%= Card::MIN_SIZE_MM %>–<%= Card::MAX_SIZE_MM %>mm
  </p>
<% end %>
