<%# 挂牌模板。数据来自 card.normalized_data，样式见 app/assets/stylesheets/badge.css %>
<div class="badge" id="badge"
     data-badge-target="badge"
     style="--badge-width: <%= card.width %>mm; --badge-height: <%= card.height %>mm; --badge-scale: <%= Card::DEFAULT_PREVIEW_SCALE %>;">
  <div class="badge__punch"></div>

  <%# 主办方抬头：机构 → 部门 → 项目主题，信息层级从大到小。 %>
  <div class="badge__header">
    <% host_org = card.normalized_data["host_organization"] %>
    <p class="badge__host-org <%= "badge__placeholder" if host_org.blank? %>">
      <%= host_org.presence || "未识别机构" %>
    </p>

    <% host_dept = card.normalized_data["host_department"] %>
    <p class="badge__host-dept <%= "badge__placeholder" if host_dept.blank? %>">
      <%= host_dept.presence || "未识别部门" %>
    </p>

    <% topic = card.normalized_data["event_topic"] %>
    <p class="badge__topic <%= "badge__placeholder" if topic.blank? %>">
      <%= topic.presence || "未识别主题" %>
    </p>
  </div>

  <% if card.portrait.attached? %>
    <%= image_tag card.portrait, class: "badge__photo", alt: "证件照" %>
  <% else %>
    <div class="badge__photo badge__photo--empty">无照片</div>
  <% end %>

  <% name = card.normalized_data["name"] %>
  <h2 class="badge__name <%= "badge__placeholder" if name.blank? %>">
    <%= name.presence || "未识别姓名" %>
  </h2>

  <div class="badge__rule"></div>

  <% org = card.normalized_data["organization"] %>
  <p class="badge__org <%= "badge__placeholder" if org.blank? %>">
    <%= org.presence || "未识别单位" %>
  </p>
</div>
