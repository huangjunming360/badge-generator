<% content_for :title, "历史记录" %>

<div class="mx-auto max-w-3xl px-6 py-16">
  <header class="mb-8 flex items-baseline justify-between">
    <h1 class="text-xl font-medium text-stone-800">历史记录</h1>
    <%= link_to "返回", root_path, class: "text-sm text-stone-500 transition hover:text-stone-800" %>
  </header>

  <% if @cards.empty? %>
    <p class="py-12 text-center text-sm text-stone-400">还没有记录。</p>
  <% else %>
    <ul class="space-y-2">
      <% @cards.each do |card| %>
        <li>
          <%= link_to card, class: "block rounded-xl border border-stone-200 bg-white px-4 py-3 transition hover:border-stone-300" do %>
            <span class="text-sm text-stone-800">
              <%= card.normalized_data["name"] || "未识别出姓名" %>
            </span>
            <span class="ml-2 text-xs text-stone-400">
              <%= card.normalized_data["organization"] %>
            </span>
            <span class="float-right text-xs text-stone-300">
              <%= card.created_at.strftime("%m-%d %H:%M") %>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
