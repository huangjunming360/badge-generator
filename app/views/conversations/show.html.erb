<% content_for :title, @conversation.display_title %>
<%= turbo_stream_from @conversation %>

<div class="flex h-screen">
  <%# 侧栏：会话列表 %>
  <aside class="hidden w-64 shrink-0 flex-col border-r border-stone-200 bg-white md:flex">
    <div class="p-4">
      <%= button_to "新对话", conversations_path,
            class: "w-full rounded-lg border border-stone-200 px-3 py-2 text-sm text-stone-600 transition hover:bg-stone-50" %>
    </div>
    <nav class="flex-1 space-y-1 overflow-y-auto px-2 pb-4">
      <% @conversations.each do |c| %>
        <%= link_to c.display_title, c,
              class: "block truncate rounded-lg px-3 py-2 text-sm transition #{c == @conversation ? 'bg-stone-100 text-stone-900' : 'text-stone-500 hover:bg-stone-50'}" %>
      <% end %>
    </nav>
  </aside>

  <%# 主区：消息流 + 输入框 %>
  <section class="flex min-w-0 flex-1 flex-col">
    <header class="flex items-center justify-between border-b border-stone-200 bg-white/80 px-6 py-3 backdrop-blur">
      <h1 class="truncate text-sm font-medium text-stone-700"><%= @conversation.display_title %></h1>
      <span class="text-xs text-stone-400"><%= Rails.application.config.x.llm[:model] %></span>
    </header>

    <div id="messages" data-chat-target="list" class="flex-1 space-y-5 overflow-y-auto px-6 py-8">
      <% if @messages.empty? %>
        <p id="empty_state" class="pt-16 text-center text-sm text-stone-400">
          问点什么吧，我会记住这个对话里说过的内容。
        </p>
      <% end %>
      <%= render partial: "messages/message", collection: @messages, as: :message %>
    </div>

    <div class="border-t border-stone-200 bg-white px-6 py-4">
      <%= render "messages/composer", conversation: @conversation %>
    </div>
  </section>
</div>
