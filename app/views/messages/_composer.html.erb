<%= form_with model: Message.new,
      url: conversation_messages_path(conversation),
      id: "composer",
      data: { controller: "composer", action: "turbo:submit-end->composer#reset" },
      class: "flex items-end gap-3" do |f| %>
  <%= f.text_area :content,
        rows: 1,
        placeholder: "输入你的问题，Enter 发送",
        data: { composer_target: "input", action: "keydown->composer#submitOnEnter input->composer#autogrow" },
        class: "max-h-40 flex-1 resize-none rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 text-sm text-stone-800 placeholder-stone-400 outline-none transition focus:border-stone-300 focus:bg-white" %>
  <%= f.submit "发送",
        class: "shrink-0 cursor-pointer rounded-xl bg-stone-800 px-5 py-3 text-sm text-white transition hover:bg-stone-700" %>
<% end %>
