<div class="mx-auto max-w-md md:w-2/3 w-full mt-16 px-4">
  <h1 class="font-bold text-3xl mb-2">注册</h1>
  <p class="text-stone-500 mb-8">创建一个账号以使用管理功能</p>

  <%= form_with model: @user, url: registration_url, class: "contents" do |f| %>
    <% if @user.errors.any? %>
      <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
        <% @user.errors.full_messages.each do |msg| %>
          <p class="text-red-600 text-sm"><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <div class="my-5">
      <%= f.label :email_address, "邮箱", class: "block text-sm font-medium mb-1" %>
      <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "your@email.com", class: "block w-full rounded-lg border border-stone-300 px-3 py-2" %>
    </div>
    <div class="my-5">
      <%= f.label :password, "密码", class: "block text-sm font-medium mb-1" %>
      <%= f.password_field :password, required: true, autocomplete: "new-password", class: "block w-full rounded-lg border border-stone-300 px-3 py-2" %>
    </div>
    <div class="my-5">
      <%= f.label :password_confirmation, "确认密码", class: "block text-sm font-medium mb-1" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "block w-full rounded-lg border border-stone-300 px-3 py-2" %>
    </div>
    <div class="mt-8">
      <%= f.submit "注册", class: "w-full px-4 py-2.5 bg-stone-800 text-white rounded-lg hover:bg-stone-700 cursor-pointer font-medium" %>
    </div>
  <% end %>

  <p class="text-center text-sm text-stone-500 mt-6">
    已有账号？<%= link_to "登录", new_session_path, class: "text-stone-800 underline hover:no-underline" %>
  </p>
</div>
