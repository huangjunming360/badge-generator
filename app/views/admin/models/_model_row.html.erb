<tr class="model-row">
  <td><input type="text" name="models[<%= i %>][id]" value="<%= m["id"] %>"></td>
  <td><input type="text" name="models[<%= i %>][label]" value="<%= m["label"] %>"></td>
  <td>
    <select name="models[<%= i %>][api]">
      <option value="anthropic" <%= "selected" if m["api"] == "anthropic" %>>Anthropic</option>
      <option value="openai" <%= "selected" if m["api"] == "openai" %>>OpenAI</option>
    </select>
  </td>
  <td><input type="text" name="models[<%= i %>][model_name]" value="<%= m["model"] %>"></td>
  <td><input type="text" name="models[<%= i %>][api_key]" value="<%= m["api_key"] %>"></td>
  <td><input type="text" name="models[<%= i %>][api_base]" value="<%= m["api_base"] %>"></td>
  <td style="text-align:center;vertical-align:middle">
    <input type="hidden" name="models[<%= i %>][no_thinking]" value="0">
    <input type="checkbox" name="models[<%= i %>][no_thinking]" value="1" <%= "checked" if m["no_thinking"] == true || m["no_thinking"].to_s == "1" %>
           style="width:14px;height:14px;cursor:pointer" title="启用后强制关闭思考模式">
  </td>
  <td>
    <select name="models[<%= i %>][level]" style="width:80px;padding:5px 4px;border:1px solid #e7e5e4;border-radius:6px;font-size:11px">
      <% levels = User.model_levels %>
      <% cur = m["level"].to_i %>
      <% unless levels.key?(cur) %>
        <option value="<%= cur %>" selected>未知(<%= cur %>)</option>
      <% end %>
      <% levels.reject { |_, v| v[:internal] }.each do |val, info| %>
        <option value="<%= val %>" <%= "selected" if cur == val %>><%= info[:label] %></option>
      <% end %>
      <% if levels.any? { |_, v| v[:internal] } %>
        <option disabled>──────────</option>
        <% levels.select { |_, v| v[:internal] }.each do |val, info| %>
          <option value="<%= val %>" <%= "selected" if cur == val %>><%= info[:label] %></option>
        <% end %>
      <% end %>
    </select>
  </td>
  <td><button type="button" class="remove-btn" onclick="removeModel(this)">×</button></td>
</tr>
