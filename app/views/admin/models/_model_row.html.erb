<tr class="model-row">
  <td><input type="text" name="models[<%= i %>][id]" value="<%= m["id"] %>"></td>
  <td><input type="text" name="models[<%= i %>][label]" value="<%= m["label"] %>"></td>
  <td>
    <select name="models[<%= i %>][api]">
      <option value="anthropic" <%= "selected" if m["api"] == "anthropic" %>>Anthropic</option>
      <option value="openai" <%= "selected" if m["api"] == "openai" %>>OpenAI</option>
    </select>
  </td>
  <td><input type="text" name="models[<%= i %>][model_name]" value="<%= m["model"] %>"></td>
  <td><input type="text" name="models[<%= i %>][api_key]" value="<%= m["api_key"] %>"></td>
  <td><input type="text" name="models[<%= i %>][api_base]" value="<%= m["api_base"] %>"></td>
  <td style="text-align:center;vertical-align:middle;white-space:nowrap">
    <input type="hidden" name="models[<%= i %>][thinking]" value="0">
    <input type="checkbox" name="models[<%= i %>][thinking]" value="1" <%= "checked" if m["thinking"] == true %>
           style="width:14px;height:14px;cursor:pointer" id="think_<%= i %>"
           onchange="document.getElementById('think_detail_<%= i %>').style.display=this.checked?'':'none'">
    <div id="think_detail_<%= i %>" style="display:<%= m["thinking"] == true ? '' : 'none' %>;margin-top:4px">
      <select name="models[<%= i %>][thinking_effort]" style="width:50px;padding:2px;border:1px solid #e7e5e4;border-radius:4px;font-size:10px">
        <option value="low" <%= "selected" if m["thinking_effort"] == "low" %>>低</option>
        <option value="medium" <%= "selected" if m["thinking_effort"] == "medium" %>>中</option>
        <option value="high" <%= "selected" if m["thinking_effort"].nil? || m["thinking_effort"] == "high" %>>高</option>
      </select>
      <input type="number" name="models[<%= i %>][thinking_budget]" value="<%= m["thinking_budget"] || 4000 %>"
             min="0" step="1000" style="width:50px;padding:2px;border:1px solid #e7e5e4;border-radius:4px;font-size:10px;margin-left:2px"
             title="token 预算">
    </div>
  </td>
  <td>
    <select name="models[<%= i %>][level]" style="width:80px;padding:5px 4px;border:1px solid #e7e5e4;border-radius:6px;font-size:11px">
      <% levels = User.model_levels %>
      <% cur = m["level"].to_i %>
      <% unless levels.key?(cur) %>
        <option value="<%= cur %>" selected>未知(<%= cur %>)</option>
      <% end %>
      <% levels.reject { |_, v| v[:internal] }.each do |val, info| %>
        <option value="<%= val %>" <%= "selected" if cur == val %>><%= info[:label] %></option>
      <% end %>
      <% if levels.any? { |_, v| v[:internal] } %>
        <option disabled>──────────</option>
        <% levels.select { |_, v| v[:internal] }.each do |val, info| %>
          <option value="<%= val %>" <%= "selected" if cur == val %>><%= info[:label] %></option>
        <% end %>
      <% end %>
    </select>
  </td>
  <td><button type="button" class="remove-btn" onclick="removeModel(this)">×</button></td>
</tr>
