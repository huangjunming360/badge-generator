<div class="mx-auto max-w-4xl px-4 py-8">
  <div class="flex items-center gap-4 mb-6">
    <%= link_to "← 后台首页", admin_root_path, class: "text-sm text-stone-500 hover:text-stone-800", style: "text-decoration:none" %>
    <h1 class="text-2xl font-bold">权限管理</h1>
  </div>

  <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 mb-6 text-sm text-amber-800">
    规则：数字越小权限越高。用户 <strong>level ≤ 模型 level</strong> 即可使用该模型。
  </div>

  <div class="bg-white rounded-xl border border-stone-200 overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-stone-50 border-b border-stone-200">
        <tr>
          <th class="text-left px-4 py-3 font-medium text-stone-600">用户</th>
          <th class="text-left px-4 py-3 font-medium text-stone-600">角色</th>
          <th class="text-left px-4 py-3 font-medium text-stone-600">当前权限</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-stone-100">
        <% @users.each do |user| %>
          <tr class="hover:bg-stone-50">
            <td class="px-4 py-3">
              <span class="font-medium"><%= user.email_address %></span>
              <% if user.banned? %>
                <span class="ml-2 text-xs text-red-500">已封禁</span>
              <% elsif !user.active? %>
                <span class="ml-2 text-xs text-yellow-500">未激活</span>
              <% end %>
            </td>
            <td class="px-4 py-3">
              <span class="px-2 py-0.5 rounded-full text-xs <%= user.admin? ? "bg-purple-100 text-purple-700" : "bg-stone-100 text-stone-600" %>">
                <%= user.admin? ? "管理员" : "用户" %>
              </span>
            </td>
            <td class="px-4 py-3">
              <% if user.admin? %>
                <span class="text-xs text-stone-400">最高（管理员锁定）</span>
              <% else %>
                <%= form_with url: admin_permission_path(user), method: :patch, local: true, style: "display:inline" do |f| %>
                  <%= f.select :model_level,
                        options_for_select(User::MODEL_LEVELS.to_a.map(&:reverse), user.model_level),
                        {},
                        class: "px-2 py-1 rounded text-xs border border-stone-300",
                        onchange: "this.form.requestSubmit()" %>
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
