<div class="mx-auto max-w-3xl px-4 py-8">
  <div class="flex items-center gap-4 mb-6">
    <%= link_to "← 后台首页", admin_root_path, class: "text-sm text-stone-500 hover:text-stone-800", style: "text-decoration:none" %>
    <h1 class="text-2xl font-bold">权限等级管理</h1>
  </div>

  <%= form_with url: admin_permissions_path, method: :patch, local: true do |f| %>
    <div class="bg-white rounded-xl border border-stone-200 divide-y divide-stone-100">
      <% User.model_levels.each do |val, info| %>
        <div class="p-5 flex items-center gap-6">
          <div class="w-16 h-10 rounded-lg bg-stone-100 flex items-center justify-center text-sm font-mono text-stone-400 shrink-0">
            Lv.<%= val %>
          </div>
          <div class="flex-1">
            <div class="flex gap-4 items-start">
              <div class="flex-1">
                <label class="block text-xs font-medium text-stone-500 mb-1">名称</label>
                <input type="text" name="levels[<%= val %>][label]" value="<%= info[:label] %>"
                       class="block w-full rounded-lg border border-stone-300 px-3 py-2 text-sm">
              </div>
              <div class="flex-[2]">
                <label class="block text-xs font-medium text-stone-500 mb-1">说明</label>
                <input type="text" name="levels[<%= val %>][desc]" value="<%= info[:desc] %>"
                       class="block w-full rounded-lg border border-stone-300 px-3 py-2 text-sm">
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="mt-6">
      <%= f.submit "保存等级设置", class: "px-6 py-2 bg-stone-800 text-white rounded-lg hover:bg-stone-700 cursor-pointer" %>
    </div>
  <% end %>
</div>
