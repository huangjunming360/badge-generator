<div class="mx-auto max-w-3xl px-4 py-8">
  <div class="flex items-center gap-4 mb-6">
    <a href="<%= admin_root_path %>" class="text-sm text-stone-500 hover:text-stone-800" style="text-decoration:none" onclick="return warnLevelsUnsaved()">← 后台首页</a>
    <h1 class="text-2xl font-bold">权限等级管理</h1>
  </div>

  <%= form_with url: admin_permissions_path, method: :patch, local: true, id: "levels-form" do |f| %>
    <div class="mb-3 text-right">
      <span id="levels-unsaved" style="display:none;color:#d97706;font-size:13px">⚠ 有未保存的更改</span>
    </div>

    <div class="text-xs text-stone-400 mb-2 px-1 flex items-center gap-2">
      <span>▲ 高权限</span>
      <span style="color:#d6d3d1">│</span>
      <span>▼ 低权限</span>
      <span style="color:#d6d3d1">│</span>
      <span>数字越小权限越高</span>
    </div>

    <div class="bg-white rounded-xl border border-stone-200 overflow-hidden" id="levels-container">
      <% User.model_levels.each do |val, info| %>
        <% next if info[:internal] %>
        <%= render "level_row", val: val, info: info %>
      <% end %>
    </div>

    <button type="button" onclick="addLevel()" class="mt-3 w-full py-2 border border-dashed border-stone-300 rounded-lg text-sm text-stone-500 hover:bg-stone-50 cursor-pointer">+ 添加等级</button>

    <div class="mt-6">
      <%= f.submit "保存等级设置", class: "px-6 py-2 bg-stone-800 text-white rounded-lg hover:bg-stone-700 cursor-pointer" %>
    </div>
  <% end %>
</div>

<template id="level-row-tmpl">
  <div class="p-4 flex items-center gap-3 group" data-level>
    <div class="flex-1">
      <input type="text" name="levels[__KEY__][label]" value="" placeholder="等级名称"
             class="block w-full rounded-lg border border-stone-300 px-3 py-2 text-sm">
    </div>
    <div class="flex-[2]">
      <input type="text" name="levels[__KEY__][desc]" value="" placeholder="等级说明"
             class="block w-full rounded-lg border border-stone-300 px-3 py-2 text-sm">
    </div>
    <button type="button" onclick="removeLevel(this)" class="text-red-400 hover:text-red-600 text-lg p-1 opacity-0 group-hover:opacity-100 transition-opacity bg-transparent border-none cursor-pointer">×</button>
  </div>
</template>

<script>
  var levelKey = <%= User.model_levels.keys.max.to_i + 1 %>;
  var levelsDirty = false;

  function track() { if (!levelsDirty) { levelsDirty = true; document.getElementById("levels-unsaved").style.display = "inline"; } }

  document.addEventListener("turbo:load", function() {
    var form = document.getElementById("levels-form");
    form.addEventListener("change", track);
    form.addEventListener("input", track);
    form.addEventListener("submit", function() { levelsDirty = false; });
    // 监听添加/删除按钮的点击
    form.querySelectorAll("[onclick^=addLevel], [onclick^=removeLevel]").forEach(function(b) {
      b.addEventListener("click", function() { setTimeout(track, 50); });
    });
  });

  window.addEventListener("beforeunload", function(e) {
    if (levelsDirty) { e.preventDefault(); e.returnValue = ""; }
  });

  function warnLevelsUnsaved() {
    if (levelsDirty) return confirm("有未保存的更改，确定离开？");
    return true;
  }

  var levelKey = <%= User.model_levels.keys.max.to_i + 1 %>;

  function addLevel() {
    var tmpl = document.getElementById("level-row-tmpl").content.cloneNode(true);
    var inputs = tmpl.querySelectorAll("input");
    inputs.forEach(function(el) {
      el.name = el.name.replace("__KEY__", levelKey);
    });
    document.getElementById("levels-container").appendChild(tmpl);
    levelKey++;
  }

  function removeLevel(btn) {
    if (!confirm("确定删除此等级？")) return;
    btn.closest("[data-level]").remove();
  }

  function moveLevel(btn, dir) {
    var row = btn.closest("[data-level]");
    var container = document.getElementById("levels-container");
    var target = dir < 0 ? row.previousElementSibling : row.nextElementSibling;
    if (!target) return;
    container.insertBefore(dir < 0 ? row : target, dir < 0 ? target : row);
    // Reindex all input names after move
    container.querySelectorAll("[data-level]").forEach(function(r, idx) {
      r.querySelectorAll("input").forEach(function(input) {
        input.name = input.name.replace(/\[\d+\]/, "[" + idx + "]");
      });
    });
    track();
  }
</script>
