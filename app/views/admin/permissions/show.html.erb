<div class="mx-auto max-w-3xl px-4 py-8">
  <div class="flex items-center gap-4 mb-6">
    <%= link_to "← 后台首页", admin_root_path, class: "text-sm text-stone-500 hover:text-stone-800", style: "text-decoration:none" %>
    <h1 class="text-2xl font-bold">权限等级管理</h1>
  </div>

  <%= form_with url: admin_permissions_path, method: :patch, local: true, id: "levels-form" do |f| %>
    <div class="bg-white rounded-xl border border-stone-200 divide-y divide-stone-100" id="levels-container">
      <% User.model_levels.each do |val, info| %>
        <%= render "level_row", val: val, info: info %>
      <% end %>
    </div>

    <button type="button" onclick="addLevel()" class="mt-3 w-full py-2 border border-dashed border-stone-300 rounded-lg text-sm text-stone-500 hover:bg-stone-50 cursor-pointer">+ 添加等级</button>

    <div class="mt-6">
      <%= f.submit "保存等级设置", class: "px-6 py-2 bg-stone-800 text-white rounded-lg hover:bg-stone-700 cursor-pointer" %>
    </div>
  <% end %>
</div>

<template id="level-row-tmpl">
  <div class="p-4 flex items-center gap-3 group" data-level>
    <div class="flex-1">
      <input type="text" name="levels[__KEY__][label]" value="" placeholder="等级名称"
             class="block w-full rounded-lg border border-stone-300 px-3 py-2 text-sm">
    </div>
    <div class="flex-[2]">
      <input type="text" name="levels[__KEY__][desc]" value="" placeholder="等级说明"
             class="block w-full rounded-lg border border-stone-300 px-3 py-2 text-sm">
    </div>
    <button type="button" onclick="removeLevel(this)" class="text-red-400 hover:text-red-600 text-lg p-1 opacity-0 group-hover:opacity-100 transition-opacity bg-transparent border-none cursor-pointer">×</button>
  </div>
</template>

<script>
  var levelKey = <%= User.model_levels.keys.max.to_i + 1 %>;

  function addLevel() {
    var tmpl = document.getElementById("level-row-tmpl").content.cloneNode(true);
    var inputs = tmpl.querySelectorAll("input");
    inputs.forEach(function(el) {
      el.name = el.name.replace("__KEY__", levelKey);
    });
    document.getElementById("levels-container").appendChild(tmpl);
    levelKey++;
  }

  function removeLevel(btn) {
    if (!confirm("确定删除此等级？")) return;
    btn.closest("[data-level]").remove();
  }
</script>
