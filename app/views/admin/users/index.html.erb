<div class="mx-auto max-w-7xl px-4 py-8">
  <div class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-4">
      <%= link_to "← 后台首页", admin_root_path, class: "text-sm text-stone-500 hover:text-stone-800" %>
      <h1 class="text-2xl font-bold">用户管理</h1>
    </div>
    <%= link_to "新建用户", new_admin_user_path, class: "px-4 py-2 bg-stone-800 text-white rounded-lg hover:bg-stone-700" %>
  </div>

  <div class="bg-white rounded-xl border border-stone-200 overflow-hidden">
    <div style="padding:10px 14px;border-bottom:1px solid #e7e5e4;display:flex;align-items:center;gap:8px">
      <span style="font-size:12px;color:#78716c">批量：</span>
      <button onclick="doBatch('activate')" class="text-xs px-2 py-1 rounded bg-green-50 text-green-700 border border-green-200 cursor-pointer hover:bg-green-100">激活</button>
      <button onclick="doBatch('deactivate')" class="text-xs px-2 py-1 rounded bg-yellow-50 text-yellow-700 border border-yellow-200 cursor-pointer hover:bg-yellow-100">停用</button>
      <button onclick="doBatch('ban')" class="text-xs px-2 py-1 rounded bg-red-50 text-red-700 border border-red-200 cursor-pointer hover:bg-red-100">封禁</button>
      <button onclick="doBatch('unban')" class="text-xs px-2 py-1 rounded bg-stone-50 text-stone-700 border border-stone-200 cursor-pointer hover:bg-stone-100">解封</button>
      <span id="batch-count" style="font-size:11px;color:#78716c;margin-left:8px;display:none"></span>
    </div>
    <script>
      function doBatch(action) {
        var ids = [];
        document.querySelectorAll(".user-checkbox:checked").forEach(function(cb) { ids.push(cb.value); });
        if (ids.length === 0) { alert("请至少选择一个用户"); return; }
        if (!confirm("确定对 " + ids.length + " 个用户执行 " + action + "？")) return;
        var f = document.createElement("form");
        f.method = "POST";
        f.action = "<%= batch_admin_users_path %>";
        var i1 = document.createElement("input"); i1.type = "hidden"; i1.name = "authenticity_token"; i1.value = document.querySelector("meta[name=csrf-token]").content; f.appendChild(i1);
        var i2 = document.createElement("input"); i2.type = "hidden"; i2.name = "user_ids"; i2.value = ids.join(","); f.appendChild(i2);
        var i3 = document.createElement("input"); i3.type = "hidden"; i3.name = "batch_action"; i3.value = action; f.appendChild(i3);
        f.style.display = "none";
        document.body.appendChild(f); f.submit();
      }
    </script>
    <table class="w-full text-sm">
      <thead class="bg-stone-50 border-b border-stone-200">
        <tr>
          <th class="text-center px-2 py-3 font-medium text-stone-600" style="width:30px"><input type="checkbox" onchange="document.querySelectorAll('.user-checkbox').forEach(c=>c.checked=this.checked)" /></th>
          <th class="text-left px-4 py-3 font-medium text-stone-600">邮箱</th>
          <th class="text-left px-4 py-3 font-medium text-stone-600">角色</th>
          <th class="text-center px-4 py-3 font-medium text-stone-600">权限等级</th>
          <th class="text-center px-4 py-3 font-medium text-stone-600">激活</th>
          <th class="text-center px-4 py-3 font-medium text-stone-600">封禁</th>
          <th class="text-left px-4 py-3 font-medium text-stone-600">注册时间</th>
          <th class="text-right px-4 py-3 font-medium text-stone-600">操作</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-stone-100">
        <% @users.each do |user| %>
          <tr class="hover:bg-stone-50">
            <td class="text-center px-2 py-3"><% unless user == Current.user %><input type="checkbox" class="user-checkbox" value="<%= user.id %>" /><% end %></td>
            <td class="px-4 py-3"><%= user.email_address %></td>
            <td class="px-4 py-3">
              <% if user == Current.user %>
                <span class="px-2 py-0.5 rounded-full text-xs <%= user.admin? ? "bg-purple-100 text-purple-700" : "bg-stone-100 text-stone-600" %>">
                  <%= user.admin? ? "管理员" : "用户" %>
                </span>
              <% else %>
                <%= button_to user.admin? ? "管理员" : "用户", toggle_role_admin_user_path(user), method: :patch,
                      data: { turbo_confirm: "确定切换 #{user.email_address} 的角色？" },
                      class: "px-2 py-0.5 rounded-full text-xs cursor-pointer border-none #{user.admin? ? 'bg-purple-100 text-purple-700' : 'bg-stone-100 text-stone-600'}" %>
              <% end %>
            </td>
            <td class="px-4 py-3 text-center">
              <% if user.admin? %>
                <span class="text-xs text-stone-400">最高</span>
              <% else %>
                <%= form_with url: update_level_admin_user_path(user), method: :patch, local: true, style: "display:inline" do |f| %>
                  <%= f.select :model_level,
                        options_for_select(User.model_level_labels_ui.to_a.map(&:reverse), user.model_level),
                        {},
                        class: "px-2 py-1 rounded text-xs border border-stone-300",
                        onchange: "this.form.requestSubmit()" %>
                <% end %>
              <% end %>
            </td>
            <td class="px-4 py-3 text-center">
              <%= button_to user.active? ? "✓ 已激活" : "未激活", toggle_active_admin_user_path(user), method: :patch,
                    data: { turbo_confirm: "确定#{user.active? ? '停用' : '激活'}该用户？" },
                    class: "px-2 py-1 rounded text-xs #{user.active? ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-700'}" %>
            </td>
            <td class="px-4 py-3 text-center">
              <% if user.banned? %>
                <%= button_to "已封禁", toggle_ban_admin_user_path(user), method: :patch,
                      data: { turbo_confirm: "确定解封该用户？" },
                      class: "px-2 py-1 rounded text-xs bg-red-100 text-red-700" %>
              <% else %>
                <span class="text-stone-400 text-xs">正常</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-stone-500"><%= l user.created_at, format: :short %></td>
            <td class="px-4 py-3" style="text-align:right;white-space:nowrap">
              <% unless user == Current.user %>
                <span onclick="var pw=prompt('新密码（至少6位）:');if(!pw){return};if(pw.length<6){alert('密码至少6位');return};var tk=document.querySelector('meta[name=csrf-token]').content;var f=document.createElement('form');f.method='POST';f.action='<%= reset_password_admin_user_path(user) %>';f.style.display='none';
var m=document.createElement('input');m.type='hidden';m.name='_method';m.value='patch';f.appendChild(m);
var a=document.createElement('input');a.type='hidden';a.name='authenticity_token';a.value=tk;f.appendChild(a);
var p=document.createElement('input');p.name='new_password';p.value=pw;f.appendChild(p);
document.body.appendChild(f);f.submit()" class="text-blue-500 hover:text-blue-700 text-xs cursor-pointer" style="text-decoration:none;margin-right:6px">重置密码</span>
                <form method="post" action="<%= admin_user_path(user) %>" style="display:inline;margin:0" onsubmit="return confirm('确定删除用户 <%= user.email_address %>？此操作不可恢复！')">
                  <input type="hidden" name="_method" value="delete">
                  <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
                  <button type="submit" class="text-red-500 hover:text-red-700 text-xs" style="background:none;border:none;cursor:pointer;padding:0;margin:0;margin-right:6px">删除</button>
                </form>
                <% unless user.banned? %>
                  <form method="post" action="<%= toggle_ban_admin_user_path(user) %>" style="display:inline;margin:0" onsubmit="return confirm('确定封禁 <%= user.email_address %>？')">
                    <input type="hidden" name="_method" value="patch">
                    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
                    <button type="submit" class="text-red-500 hover:text-red-700 text-xs" style="background:none;border:none;cursor:pointer;padding:0;margin:0">封禁</button>
                  </form>
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
