<div class="mx-auto max-w-7xl px-4 py-8">
  <div class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-4">
      <h1 class="text-2xl font-bold">管理后台</h1>
    </div>
    <%= link_to "← 返回应用", root_path, class: "text-sm text-stone-500 hover:text-stone-800" %>
  </div>

  <div class="grid grid-cols-3 gap-4 mb-8">
    <div class="bg-white rounded-xl p-6 border border-stone-200">
      <p class="text-sm text-stone-500">总用户</p>
      <p class="text-3xl font-bold mt-1"><%= @user_count %></p>
    </div>
    <div class="bg-white rounded-xl p-6 border border-stone-200">
      <p class="text-sm text-stone-500">已激活</p>
      <p class="text-3xl font-bold mt-1 text-green-600"><%= @active_count %></p>
    </div>
    <div class="bg-white rounded-xl p-6 border border-stone-200">
      <p class="text-sm text-stone-500">已封禁</p>
      <p class="text-3xl font-bold mt-1 text-red-600"><%= @banned_count %></p>
    </div>
  </div>

  <div class="flex gap-4">
    <%= link_to "用户管理", admin_users_path, class: "px-4 py-2 bg-stone-800 text-white rounded-lg hover:bg-stone-700" %>
    <%= link_to "通用设置", admin_general_settings_path, class: "px-4 py-2 bg-stone-800 text-white rounded-lg hover:bg-stone-700" %>
    <%= link_to "模型配置", admin_models_path, class: "px-4 py-2 bg-stone-800 text-white rounded-lg hover:bg-stone-700" %>
  </div>
</div>
