TEMPLATE_AGENT_SERVER_URL=https://your-zero-tier-rails-host
TEMPLATE_AGENT_NODE_ID=home-4090
TEMPLATE_AGENT_NODE_TOKEN=replace-with-node-secret
TEMPLATE_AGENT_POLL_INTERVAL_SECONDS=15
TEMPLATE_AGENT_REQUEST_TIMEOUT_SECONDS=30
TEMPLATE_AGENT_LEASE_HEARTBEAT_SECONDS=30
TEMPLATE_AGENT_MAI_BASE_URL=http://127.0.0.1:18000/v1
TEMPLATE_AGENT_RENDERER_IMAGE=badge-template-renderer:local
# Leave empty to use the Claude Code account default model. The SDK reads
# ANTHROPIC_API_KEY / Claude Code credentials from the node host, never Rails.
TEMPLATE_AGENT_CLAUDE_MODEL=
# Optional node-local fallback. An administrator can select a compatible
# configured model in the GPU node page; its model name/Base URL will override
# these two values on the next heartbeat. The key is always node-local.
TEMPLATE_AGENT_CLAUDE_BASE_URL=
TEMPLATE_AGENT_CLAUDE_API_KEY=
TEMPLATE_AGENT_CLAUDE_MAX_TURNS=6
